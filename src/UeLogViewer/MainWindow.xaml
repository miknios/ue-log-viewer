<Window x:Class="UeLogViewer.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="UE Log Viewer" Width="1500" Height="900"
		Closing="OnWindowClosing">
	<Window.Resources>
		<Style x:Key="LineStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#D4D4D4" />
			<Setter Property="FontFamily" Value="Consolas" />
			<Setter Property="FontSize" Value="12" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Level}" Value="Fatal">
					<Setter Property="Foreground" Value="#FF5555" />
					<Setter Property="FontWeight" Value="Bold" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Level}" Value="Error">
					<Setter Property="Foreground" Value="#F14C4C" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Level}" Value="Warning">
					<Setter Property="Foreground" Value="#E5C07B" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Level}" Value="Verbose">
					<Setter Property="Foreground" Value="#8A8A8A" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Level}" Value="VeryVerbose">
					<Setter Property="Foreground" Value="#8A8A8A" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<DataTemplate x:Key="FullLineTemplate">
			<TextBlock Text="{Binding Raw}" Style="{StaticResource LineStyle}" />
		</DataTemplate>
		<DataTemplate x:Key="ShortLineTemplate">
			<TextBlock Text="{Binding Short}" Style="{StaticResource LineStyle}" />
		</DataTemplate>

		<Style x:Key="LogItemStyle" TargetType="ListBoxItem">
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="#2A2D2E" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="#264F78" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="CheckBox">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,14,0" />
		</Style>
		<Style TargetType="Button">
			<Setter Property="Padding" Value="10,2" />
		</Style>
	</Window.Resources>

	<DockPanel>
		<!-- Top bar: file and filters -->
		<Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Background="#F3F3F3">
			<StackPanel>
				<DockPanel Margin="0,0,0,6">
					<TextBlock Text="Log file:" VerticalAlignment="Center" Margin="0,0,6,0" />
					<Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowse" Margin="6,0,0,0" />
					<Button DockPanel.Dock="Right" Content="Open" Click="OnOpenPath" Margin="6,0,0,0" />
					<TextBox x:Name="PathBox" KeyDown="OnPathKeyDown" VerticalContentAlignment="Center" Padding="2" />
				</DockPanel>
				<DockPanel>
					<Button DockPanel.Dock="Right" Content="Clear" Click="OnClear" ToolTip="Hide everything logged so far (the file is untouched)" />
					<StackPanel Orientation="Horizontal">
						<CheckBox x:Name="ErrorsCheck" Content="Errors" Foreground="#C42B1C" FontWeight="SemiBold" Click="OnFilterToggled" />
						<CheckBox x:Name="WarningsCheck" Content="Warnings" Foreground="#9A6700" FontWeight="SemiBold" Click="OnFilterToggled" />
						<CheckBox x:Name="LogsCheck" Content="Logs" Click="OnFilterToggled" />
						<TextBlock Text="Search:" VerticalAlignment="Center" Margin="6,0,6,0" />
						<TextBox x:Name="SearchBox" Width="340" Padding="2" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" ToolTip="Text to find in the line (case-insensitive). Esc clears." KeyDown="OnSearchKeyDown" />
						<CheckBox x:Name="RegexCheck" Content="Regex" Margin="8,0,14,0" Click="OnFilterToggled" />
						<CheckBox x:Name="TimestampsCheck" Content="Timestamps" Click="OnTimestampsToggled" />
						<CheckBox x:Name="FollowCheck" Content="Follow end" Checked="OnFollowChecked" Unchecked="OnFollowUnchecked" ToolTip="Stick to the newest line. Turns off when you scroll up, back on when you reach the bottom (or press End)." />
					</StackPanel>
				</DockPanel>
			</StackPanel>
		</Border>

		<!-- Status bar -->
		<Border DockPanel.Dock="Bottom" Padding="8,3" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Background="#F3F3F3">
			<TextBlock x:Name="StatusText" />
		</Border>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="CategoryColumn" Width="260" MinWidth="150" />
				<ColumnDefinition Width="5" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Categories -->
			<DockPanel Grid.Column="0" Margin="6">
				<TextBlock DockPanel.Dock="Top" Text="Categories" FontWeight="SemiBold" Margin="0,0,0,4" />
				<DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
					<TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />
					<TextBox x:Name="CategorySearchBox" Padding="2" TextChanged="OnCategorySearchChanged" />
				</DockPanel>
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
					<Button Content="All" Click="OnShowAllCategories" Margin="0,0,6,0" ToolTip="Show every category, including ones that appear later" />
					<Button Content="None" Click="OnHideAllCategories" ToolTip="Hide every category, including ones that appear later" />
				</StackPanel>
				<CheckBox x:Name="NewCategoriesCheck" DockPanel.Dock="Top" Content="Show new categories" Margin="0,0,0,6" Click="OnNewCategoriesToggled"
						  ToolTip="Whether categories that first appear after now start visible" />
				<ListBox x:Name="CategoryList" HorizontalContentAlignment="Stretch"
						 VirtualizingPanel.IsVirtualizing="True">
					<ListBox.ContextMenu>
						<ContextMenu>
							<MenuItem Header="Show only this category" Click="OnCategoryShowOnly" />
						</ContextMenu>
					</ListBox.ContextMenu>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<DockPanel ToolTip="Double-click: show only this category">
								<TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="#808080" Margin="6,0,0,0" />
								<CheckBox IsChecked="{Binding IsVisible}" Content="{Binding Name}" Margin="0" />
							</DockPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<EventSetter Event="MouseDoubleClick" Handler="OnCategoryDoubleClick" />
						</Style>
					</ListBox.ItemContainerStyle>
				</ListBox>
			</DockPanel>

			<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0" DragCompleted="OnSplitterDragged" />

			<!-- Log lines -->
			<ListBox x:Name="LogList" Grid.Column="2"
					 Background="#1E1E1E" BorderThickness="0"
					 SelectionMode="Extended"
					 ItemContainerStyle="{StaticResource LogItemStyle}"
					 VirtualizingPanel.IsVirtualizing="True"
					 VirtualizingPanel.VirtualizationMode="Recycling"
					 VirtualizingPanel.ScrollUnit="Item"
					 ScrollViewer.CanContentScroll="True"
					 ScrollViewer.HorizontalScrollBarVisibility="Auto"
					 Loaded="OnLogListLoaded"
					 ContextMenuOpening="OnLogContextMenuOpening">
				<ListBox.CommandBindings>
					<CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" />
				</ListBox.CommandBindings>
				<ListBox.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
						<Separator />
						<MenuItem x:Name="ShowOnlyMenuItem" Click="OnLineShowOnlyCategory" />
						<MenuItem x:Name="HideCategoryMenuItem" Click="OnLineHideCategory" />
					</ContextMenu>
				</ListBox.ContextMenu>
			</ListBox>
			<TextBlock x:Name="NoFileHint" Grid.Column="2" Visibility="Collapsed" IsHitTestVisible="False"
					   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
					   Foreground="#8A8A8A" FontSize="14"
					   Text="No log file selected.&#10;Click Browse… or paste a path above and press Enter.&#10;(Usually &lt;Project&gt;\Saved\Logs\&lt;Project&gt;.log)" />
		</Grid>
	</DockPanel>
</Window>
